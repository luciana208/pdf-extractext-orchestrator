# copiar a .env para correr fuera de docker; en el sistema completo las setea pdf-extractext-deploy
SERVICE_NAME=pdf-extractext-orchestrator
SERVICE_VERSION=1.0.0
LOG_LEVEL=INFO
GRANIAN_PORT=8000

MAX_PDF_SIZE_MB=10
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# servicios internos, se llega a traves del entrypoint interno de traefik
VALIDATION_URL=http://validation.internal:8000
EXTRACTION_URL=http://extract.internal:8000
DOCUMENTS_URL=http://documents.internal:8000

VALIDATION_TIMEOUT=10
EXTRACTION_TIMEOUT=60
DOCUMENTS_TIMEOUT=10
HTTP_CONNECT_RETRIES=2

CONSUL_ENABLED=false
CONSUL_URL=http://consul:8500
CONSUL_TOKEN=
SERVICE_ADDRESS=
HEALTH_CHECK_INTERVAL=10s

ROUTER_NAME=api
PUBLIC_HOST=api.pdfextractext.localhost
INTERNAL_HOST=
RETRY_ATTEMPTS=3
RETRY_INITIAL_INTERVAL=100ms
